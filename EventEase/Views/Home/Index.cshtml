@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-4">Welcome to EventEase</h1>
    <p class="lead">Simplifying venue management and event scheduling.</p>
    <hr />

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Manage Venues</h5>
                    <p class="card-text">View and add locations for your events.</p>
                    <a asp-controller="Venues" asp-action="Index" class="btn btn-primary">Go to Venues</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">View Events</h5>
                    <p class="card-text">Schedule and coordinate upcoming events.</p>
                    <a asp-controller="Events" asp-action="Index" class="btn btn-primary">Go to Events</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Bookings</h5>
                    <p class="card-text">Secure a venue for your event here.</p>
                    <a asp-controller="Bookings" asp-action="Index" class="btn btn-success">Manage Bookings</a>
                </div>
            </div>
        </div>
    </div>
</div>